# Copia este archivo como .env para cambiar las credenciales de docker compose.
POSTGRES_DB=infection_solutions
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
ADMIN_EMAIL=admin@infection.com
ADMIN_PASSWORD=Admin123*

# API (S3). Clave para firmar los JWT: 32 caracteres o mas, distinta en cada entorno.
JWT_SIGNING_KEY=cambia-esta-clave-por-una-larga-y-aleatoria-0123456789
# Gmail: la cuenta y una contraseña de aplicacion (https://myaccount.google.com/apppasswords).
# Vacias = los correos no salen y quedan en el log de la API.
SMTP_USERNAME=
SMTP_PASSWORD=
# Origen del cliente Angular (CORS).
CLIENT_ORIGIN=http://localhost:4200
