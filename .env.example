# Copia este archivo como .env (junto a docker-compose.yml) y cambia los valores.
# .env no se sube a GitHub: ahi van las contraseñas reales.

# --- Base de datos (solo visible dentro de Docker) ---
POSTGRES_DB=infection_solutions
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambia-esta-clave

# --- Administrador inicial del panel ---
ADMIN_EMAIL=admin@infection.com
ADMIN_PASSWORD=Admin123*

# Datos de demostracion si la base esta vacia (true/false).
SEED_DEMO_DATA=true

# --- API ---
# Clave para firmar los JWT: 32 caracteres o mas, distinta en cada entorno.
# Una buena: openssl rand -base64 48
JWT_SIGNING_KEY=cambia-esta-clave-por-una-larga-y-aleatoria-0123456789
SWAGGER_ENABLED=true

# Gmail: la cuenta y una contraseña de aplicacion (https://myaccount.google.com/apppasswords).
# Vacias = los correos no salen y quedan en el log de la API.
SMTP_USERNAME=
SMTP_PASSWORD=

# --- Puertos publicados en el host ---
ADMIN_PORT=8080
API_PORT=8081
CLIENT_PORT=8082

# --- Imagenes (por defecto las publicadas en GHCR) ---
# ADMIN_IMAGE=ghcr.io/esthercita-factory/nicholas-delarosa-infectionsolutions-admin:latest
# API_IMAGE=ghcr.io/esthercita-factory/nicholas-delarosa-infectionsolutions-api:latest
# CLIENT_IMAGE=ghcr.io/esthercita-factory/nicholas-delarosa-infectionsolutions.client:latest

# Construir el portal desde una copia local en vez de GitHub:
# CLIENT_BUILD_CONTEXT=../InfectionSolutions.Client
