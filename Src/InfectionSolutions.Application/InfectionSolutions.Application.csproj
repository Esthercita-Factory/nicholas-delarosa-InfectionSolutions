<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\InfectionSolutions.Domain\InfectionSolutions.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AutoMapper" Version="16.1.1" />
    <PackageReference Include="EPPlus" Version="8.7.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.12" />
    <PackageReference Include="QuestPDF" Version="2026.9.1" />
    <!-- Transitivos de EPPlus y MailKit: se fija la 10.0.13 por advisories de 10.0.0 a 10.0.12
         (Pkcs: CVE-2026-84008; Xml: CVE-2026-96958, 96959 y 96960). -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.13" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Archivo (SIL OFL 1.1): se incrusta para que los PDF se vean igual en Windows y en Docker. -->
    <EmbeddedResource Include="Fonts\*.ttf" />
    <None Include="Fonts\OFL.txt" />
  </ItemGroup>

</Project>
