@model SaleResponse
@{
    ViewData["Title"] = $"Venta {Model.SaleNumber}";
}

<section class="page-header">
    <div>
        <h1 class="h3 mb-1">Venta @Model.SaleNumber</h1>
        <p class="text-muted mb-0">
            @Model.SaleDate.ToLocalTime().ToString("f") ·
            <span class="badge rounded-pill @Model.Status.ToBadgeClass()">@Model.Status.ToDisplay()</span>
        </p>
    </div>
    @if (Model.Status == SaleStatus.Completed)
    {
        <form asp-action="Cancel" asp-route-id="@Model.Id" method="post"
              onsubmit="return confirm('¿Anular la venta @Model.SaleNumber? El stock se devolverá al inventario.');">
            <button type="submit" class="btn btn-outline-danger"><i class="bi bi-x-circle me-1"></i> Anular venta</button>
        </form>
    }
</section>

<div class="row g-3">
    <div class="col-12 col-xl-8">
        <div class="card">
            <div class="card-header fw-semibold">Productos</div>
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead>
                    <tr>
                        <th class="ps-4">Producto</th>
                        <th class="text-end">Cantidad</th>
                        <th class="text-end">Precio unitario</th>
                        <th class="text-end pe-4">Subtotal</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var d in Model.Details)
                    {
                        <tr>
                            <td class="ps-4">
                                <a asp-controller="Products" asp-action="Details" asp-route-id="@d.ProductId" class="fw-semibold">@d.ProductName</a>
                                <div class="small text-muted">@d.Sku</div>
                            </td>
                            <td class="text-end">@d.Quantity <span class="text-muted small">@d.Unit</span></td>
                            <td class="text-end">@d.UnitPrice.ToString("C2")</td>
                            <td class="text-end pe-4 fw-semibold">@d.LineTotal.ToString("C2")</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.Notes))
        {
            <div class="card mt-3">
                <div class="card-body">
                    <div class="small text-muted text-uppercase mb-1">Observaciones</div>
                    @Model.Notes
                </div>
            </div>
        }
    </div>

    <div class="col-12 col-xl-4">
        <div class="card mb-3">
            <div class="card-body p-4">
                <h2 class="h6 text-uppercase text-muted mb-3">Cliente</h2>
                <a asp-controller="Customers" asp-action="Details" asp-route-id="@Model.CustomerId" class="fw-semibold d-block">@Model.CustomerName</a>
                <div class="small text-muted">Documento @Model.CustomerDocument</div>
                <div class="small mt-2"><i class="bi bi-envelope me-1"></i>@Model.CustomerEmail</div>
                <div class="small"><i class="bi bi-telephone me-1"></i>@Model.CustomerPhone</div>
            </div>
        </div>

        <div class="card summary-card">
            <div class="card-body p-4">
                <h2 class="h6 text-uppercase text-muted mb-3">Totales</h2>
                <div class="d-flex justify-content-between mb-2"><span>Subtotal</span><span>@Model.Subtotal.ToString("C2")</span></div>
                <div class="d-flex justify-content-between mb-2"><span>IVA</span><span>@Model.Tax.ToString("C2")</span></div>
                <hr>
                <div class="d-flex justify-content-between fs-5 fw-bold"><span>Total</span><span>@Model.Total.ToString("C2")</span></div>
                @if (Model.CancelledAt is not null)
                {
                    <p class="small text-muted mt-3 mb-0">Anulada el @Model.CancelledAt.Value.ToLocalTime().ToString("g").</p>
                }
            </div>
        </div>
    </div>
</div>

<a asp-action="Index" class="btn btn-link px-0 mt-3"><i class="bi bi-arrow-left me-1"></i> Volver a ventas</a>
