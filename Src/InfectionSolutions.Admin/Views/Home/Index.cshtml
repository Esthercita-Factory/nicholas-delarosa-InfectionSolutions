@model DashboardSummary
@using System.Globalization
@{
    ViewData["Title"] = "Inicio";
    var minimo = InfectionSolutions.Application.Services.Dashboard.DashboardService.LowStockThreshold;
    var ahora = DateTime.Now;
    var saludo = ahora.Hour < 12 ? "Buenos días" : ahora.Hour < 19 ? "Buenas tardes" : "Buenas noches";
    var hoy = ahora.ToString("dddd d 'de' MMMM", CultureInfo.GetCultureInfo("es-CO"));
}

<section class="page-header">
    <div>
        <h1>@saludo</h1>
        <p>Hoy es @hoy. Así va el mostrador este mes.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="Products" asp-action="Create" class="btn btn-outline-secondary"><i class="bi bi-plus-square"></i>Agregar producto</a>
        <a asp-controller="Sales" asp-action="Create" class="btn btn-primary"><i class="bi bi-cart-plus"></i>Registrar venta</a>
    </div>
</section>

<section class="kpis" aria-label="Indicadores">
    <div class="kpi is-key">
        <span class="kpi-label"><span class="kpi-icon"><i class="bi bi-cash-stack"></i></span>Ingresos del mes</span>
        <span class="kpi-value" data-count="@decimal.Round(Model.RevenueThisMonth, 0).ToString(CultureInfo.InvariantCulture)" data-format="money">@Model.RevenueThisMonth.ToString("C0")</span>
        <span class="kpi-note">IVA incluido, @Model.SalesThisMonth @(Model.SalesThisMonth == 1 ? "venta" : "ventas")</span>
    </div>
    <a class="kpi" asp-controller="Sales" asp-action="Index">
        <i class="bi bi-arrow-up-right kpi-go" aria-hidden="true"></i>
        <span class="kpi-label"><span class="kpi-icon"><i class="bi bi-receipt"></i></span>Ventas registradas</span>
        <span class="kpi-value" data-count="@Model.TotalSales">@Model.TotalSales</span>
        <span class="kpi-note">sin contar las anuladas</span>
    </a>
    <a class="kpi" asp-controller="Products" asp-action="Index">
        <i class="bi bi-arrow-up-right kpi-go" aria-hidden="true"></i>
        <span class="kpi-label"><span class="kpi-icon"><i class="bi bi-box-seam"></i></span>Productos</span>
        <span class="kpi-value" data-count="@Model.TotalProducts">@Model.TotalProducts</span>
        <span class="kpi-note">@Model.ActiveProducts a la venta</span>
    </a>
    <a class="kpi" asp-controller="Customers" asp-action="Index">
        <i class="bi bi-arrow-up-right kpi-go" aria-hidden="true"></i>
        <span class="kpi-label"><span class="kpi-icon"><i class="bi bi-people"></i></span>Clientes</span>
        <span class="kpi-value" data-count="@Model.TotalCustomers">@Model.TotalCustomers</span>
        <span class="kpi-note">registrados</span>
    </a>
</section>

<div class="row g-4">
    <div class="col-12 col-xl-8 d-flex flex-column gap-4">
        <section class="card">
            <div class="card-header">
                <h2 class="panel-title mb-0">Ingresos de las últimas dos semanas</h2>
            </div>
            <partial name="_SalesChart" model="Model.SalesByDay" />
        </section>

        <section class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h2 class="panel-title mb-0">Últimas ventas</h2>
                <a asp-controller="Sales" asp-action="Index" class="btn btn-sm btn-outline-secondary">Ver todas</a>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                    <tr>
                        <th class="ps-4">Venta</th>
                        <th>Cliente</th>
                        <th class="text-end pe-4">Total</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var venta in Model.RecentSales)
                    {
                        <tr class="@(venta.IsCancelled ? "text-body-secondary" : null)">
                            <td class="ps-4">
                                <a asp-controller="Sales" asp-action="Details" asp-route-id="@venta.Id" class="fw-semibold">@venta.SaleNumber</a>
                                <div class="small text-muted">@venta.SaleDate.ToLocalTime().ToString("g")</div>
                            </td>
                            <td>@venta.CustomerName</td>
                            <td class="text-end pe-4">
                                @if (venta.IsCancelled)
                                {
                                    <span class="badge text-bg-secondary">Anulada</span>
                                }
                                else
                                {
                                    <span class="fw-semibold">@venta.Total.ToString("C2")</span>
                                }
                            </td>
                        </tr>
                    }
                    @if (Model.RecentSales.Count == 0)
                    {
                        <tr>
                            <td colspan="3" class="text-center text-muted py-5">
                                Todavía no hay ventas. <a asp-controller="Sales" asp-action="Create" class="text-decoration-underline">Registra la primera</a>.
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </section>
    </div>

    <div class="col-12 col-xl-4">
        <section class="card">
            <div class="card-header">
                <h2 class="panel-title mb-0">Por reponer</h2>
                <p class="small text-muted mb-0 mt-1">Productos a la venta con @minimo unidades o menos.</p>
            </div>
            <ul class="list-unstyled mb-0">
                @foreach (var producto in Model.LowStockProducts)
                {
                    var porcentaje = Math.Clamp(producto.Stock * 100 / Math.Max(minimo, 1), 0, 100);
                    <li class="px-4 py-3 border-bottom">
                        <div class="d-flex justify-content-between align-items-baseline gap-3 mb-2">
                            <a asp-controller="Products" asp-action="Details" asp-route-id="@producto.Id" class="fw-semibold">@producto.Name</a>
                            @if (producto.Stock == 0)
                            {
                                <span class="badge text-bg-danger">Agotado</span>
                            }
                            else
                            {
                                <span class="num small">@producto.Stock disponibles</span>
                            }
                        </div>
                        <div class="stock-meter @(producto.Stock == 0 ? "is-empty" : null)" role="img" aria-label="@producto.Stock de @minimo unidades mínimas">
                            <span style="width: @porcentaje%"></span>
                        </div>
                        <div class="small text-muted mt-1">@producto.Sku</div>
                    </li>
                }
                @if (Model.LowStockProducts.Count == 0)
                {
                    <li class="px-4 py-5 text-center text-muted">
                        <i class="bi bi-check2-circle d-block fs-3 mb-2" aria-hidden="true"></i>
                        Ningún producto está por debajo del mínimo.
                    </li>
                }
            </ul>
        </section>
    </div>
</div>
