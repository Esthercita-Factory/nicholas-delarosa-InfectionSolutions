<!DOCTYPE html>
@{
    var controladorActual = ViewContext.RouteData.Values["controller"]?.ToString();
    var accionActual = ViewContext.RouteData.Values["action"]?.ToString();
    bool EsActual(string controlador, string? accion = null)
        => controladorActual == controlador && (accion is null || accionActual == accion);
    string Activo(string controlador, string? accion = null) => EsActual(controlador, accion) ? "is-active" : string.Empty;
    string? Actual(string controlador, string? accion = null) => EsActual(controlador, accion) ? "page" : null;
    var correo = User.Identity?.Name ?? string.Empty;
    var inicial = string.IsNullOrEmpty(correo) ? "A" : correo[..1].ToUpperInvariant();
    var seccion = controladorActual switch
    {
        "Products" => "Productos",
        "Customers" => "Clientes",
        "Sales" => "Ventas",
        "Imports" => "Importar Excel",
        "Account" => "Cuenta",
        _ => "Inicio"
    };
}
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <partial name="_ThemeHead" />
    <title>@ViewData["Title"] | InfectionSolutions</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..100,400..800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<a class="skip-link" href="#contenido">Saltar al contenido</a>
<div class="shell">
    <aside class="rail offcanvas-lg offcanvas-start" tabindex="-1" id="rail" aria-labelledby="railLabel">
        <div class="rail-brand">
            <a asp-controller="Home" asp-action="Index" class="wordmark" id="railLabel">
                <span class="wordmark-stripe" aria-hidden="true"></span>
                <span>InfectionSolutions</span>
            </a>
            <button type="button" class="btn-close btn-close-white ms-auto d-lg-none" data-bs-dismiss="offcanvas" data-bs-target="#rail" aria-label="Cerrar menú"></button>
        </div>

        <nav class="rail-nav" aria-label="Navegación principal" data-rail-nav>
            <span class="rail-indicator" aria-hidden="true" data-rail-indicator></span>

            <a class="rail-link @Activo("Home")" aria-current="@Actual("Home")" asp-controller="Home" asp-action="Index">
                <i class="bi bi-grid-1x2" aria-hidden="true"></i><span>Inicio</span>
            </a>

            <p class="rail-group">Mostrador</p>
            <a class="rail-link @Activo("Sales")" aria-current="@Actual("Sales")" asp-controller="Sales" asp-action="Index">
                <i class="bi bi-receipt" aria-hidden="true"></i><span>Ventas</span>
            </a>
            <a class="rail-link @Activo("Products")" aria-current="@Actual("Products")" asp-controller="Products" asp-action="Index">
                <i class="bi bi-box-seam" aria-hidden="true"></i><span>Productos</span>
            </a>
            <a class="rail-link @Activo("Customers")" aria-current="@Actual("Customers")" asp-controller="Customers" asp-action="Index">
                <i class="bi bi-people" aria-hidden="true"></i><span>Clientes</span>
            </a>

            <p class="rail-group">Bodega</p>
            <a class="rail-link @Activo("Imports")" aria-current="@Actual("Imports")" asp-controller="Imports" asp-action="Index">
                <i class="bi bi-file-earmark-arrow-up" aria-hidden="true"></i><span>Importar Excel</span>
            </a>

            <p class="rail-group">Cuenta</p>
            <a class="rail-link @Activo("Account", "Register")" aria-current="@Actual("Account", "Register")" asp-controller="Account" asp-action="Register">
                <i class="bi bi-person-plus" aria-hidden="true"></i><span>Nuevo administrador</span>
            </a>
        </nav>

        <div class="rail-cta">
            <a asp-controller="Sales" asp-action="Create" class="btn btn-accent w-100">
                <i class="bi bi-plus-lg" aria-hidden="true"></i> Registrar venta
            </a>
        </div>
    </aside>

    <div class="main">
        <header class="topbar">
            <button class="btn btn-icon d-lg-none" type="button" data-bs-toggle="offcanvas" data-bs-target="#rail" aria-controls="rail" aria-label="Abrir menú">
                <i class="bi bi-list"></i>
            </button>

            <nav class="crumbs" aria-label="Ubicación">
                <a asp-controller="Home" asp-action="Index">Panel</a>
                <i class="bi bi-chevron-right" aria-hidden="true"></i>
                <span aria-current="page">@seccion</span>
            </nav>

            <button type="button" class="search-trigger ms-auto" data-palette-open aria-haspopup="dialog">
                <i class="bi bi-search" aria-hidden="true"></i>
                <span class="d-none d-md-inline">Buscar o ir a…</span>
                <kbd class="d-none d-md-inline">Ctrl K</kbd>
            </button>

            <partial name="_ThemeToggle" />

            <div class="dropdown">
                <button class="user-chip" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Menú de la cuenta">
                    <span class="avatar">@inicial</span>
                    <i class="bi bi-chevron-down d-none d-sm-inline" aria-hidden="true"></i>
                </button>
                <div class="dropdown-menu dropdown-menu-end">
                    <div class="dropdown-identity">
                        <span class="avatar avatar-lg">@inicial</span>
                        <div class="text-truncate">
                            <strong class="d-block text-truncate">@correo</strong>
                            <span class="small text-muted">Administrador</span>
                        </div>
                    </div>
                    <a class="dropdown-item" asp-controller="Account" asp-action="Register"><i class="bi bi-person-plus"></i>Nuevo administrador</a>
                    <form asp-controller="Account" asp-action="Logout" method="post">
                        <button type="submit" class="dropdown-item text-danger"><i class="bi bi-box-arrow-right"></i>Cerrar sesión</button>
                    </form>
                </div>
            </div>
        </header>

        <main class="content" id="contenido" role="main">
            @RenderBody()
        </main>

        <footer class="footer">
            <span>InfectionSolutions, venta y distribución de materiales de construcción</span>
            <span>Panel administrativo</span>
        </footer>
    </div>
</div>

<partial name="_Alerts" />
<partial name="_CommandPalette" />

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/theme.js" asp-append-version="true"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
