@* Boton de modo claro/oscuro. La logica (y la transicion circular) esta en theme.js. *@
<button type="button" class="theme-toggle @ViewData["ThemeToggleClass"]" data-theme-toggle aria-label="Cambiar a modo oscuro" title="Cambiar tema">
    <i class="bi bi-moon-stars-fill" aria-hidden="true"></i>
    <i class="bi bi-sun-fill" aria-hidden="true"></i>
</button>
