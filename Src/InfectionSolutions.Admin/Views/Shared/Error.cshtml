@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
    Layout = User.Identity?.IsAuthenticated == true ? "_Layout" : "_AuthLayout";
}

<div class="text-center py-5">
    <div class="display-4 text-danger mb-3"><i class="bi bi-exclamation-octagon"></i></div>
    <h1 class="h3">Algo salió mal</h1>
    <p class="text-muted">Ocurrió un error inesperado al procesar tu solicitud. Ya quedó registrado; intenta de nuevo en unos minutos.</p>

    @if (Model.ShowRequestId)
    {
        <p class="small text-muted">Código de referencia: <code>@Model.RequestId</code></p>
    }

    <a asp-controller="Home" asp-action="Index" class="btn btn-primary mt-2">Volver al inicio</a>
</div>
