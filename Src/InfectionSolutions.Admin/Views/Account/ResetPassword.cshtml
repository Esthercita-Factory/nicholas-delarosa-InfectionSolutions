@model ResetPasswordViewModel
@{
    ViewData["Title"] = "Nueva contraseña";
    Layout = "_AuthLayout";
}

<div>
    <h1>Nueva contraseña</h1>
    <p class="text-muted mb-4">Para <strong>@Model.Email</strong>. Mínimo 8 caracteres, con mayúscula, número y símbolo.</p>

    <form asp-action="ResetPassword" method="post" novalidate>
        <input type="hidden" asp-for="Email" />
        <input type="hidden" asp-for="Token" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger small py-2" role="alert"></div>

        <div class="mb-3">
            <label asp-for="Password" class="form-label"></label>
            <input asp-for="Password" class="form-control form-control-lg" autocomplete="new-password" autofocus>
            <span asp-validation-for="Password" class="text-danger small"></span>
        </div>

        <div class="mb-4">
            <label asp-for="ConfirmPassword" class="form-label"></label>
            <input asp-for="ConfirmPassword" class="form-control form-control-lg" autocomplete="new-password">
            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
        </div>

        <button type="submit" class="btn btn-primary btn-lg w-100">Cambiar contraseña</button>
    </form>

    <p class="text-center mt-4 mb-0"><a asp-action="ForgotPassword">Pedir otro enlace</a></p>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
