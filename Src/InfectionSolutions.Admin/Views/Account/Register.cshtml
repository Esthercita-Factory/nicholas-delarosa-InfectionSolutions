@model RegisterAdminViewModel
@{
    ViewData["Title"] = "Nuevo administrador";
}

<section class="page-header">
    <div>
        <h1 class="h3 mb-1">Nuevo administrador</h1>
        <p class="text-muted mb-0">Crea una cuenta con acceso completo al panel. Los clientes se registran desde el portal.</p>
    </div>
</section>

<div class="row">
    <div class="col-12 col-lg-8 col-xl-6">
        <div class="card">
            <div class="card-body p-4">
                <form asp-action="Register" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger small py-2" role="alert"></div>

                    <div class="row g-3">
                        <div class="col-12">
                            <label asp-for="FullName" class="form-label"></label>
                            <input asp-for="FullName" class="form-control" placeholder="Laura Mendoza" maxlength="120">
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Email" class="form-label"></label>
                            <input asp-for="Email" class="form-control" placeholder="nombre@infection.com" maxlength="120" autocomplete="off">
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                        <div class="col-12 col-sm-6">
                            <label asp-for="Password" class="form-label"></label>
                            <input asp-for="Password" class="form-control" autocomplete="new-password">
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>
                        <div class="col-12 col-sm-6">
                            <label asp-for="ConfirmPassword" class="form-label"></label>
                            <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password">
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <div class="form-text">Mínimo 8 caracteres, con mayúscula, número y símbolo.</div>
                        </div>
                    </div>

                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn btn-primary">Crear administrador</button>
                        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
