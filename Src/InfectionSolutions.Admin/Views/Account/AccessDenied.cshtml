@{
    ViewData["Title"] = "Acceso denegado";
    Layout = "_AuthLayout";
}

<div class="text-center">
    <div class="display-5 text-warning mb-3"><i class="bi bi-shield-lock"></i></div>
    <h2 class="h4 fw-bold">Acceso restringido</h2>
