@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Recuperar contraseña";
    Layout = "_AuthLayout";
}

<div>
    <h1>Recuperar contraseña</h1>
    <p class="text-muted mb-4">Escribe el correo de tu cuenta de administrador y te enviamos un enlace para elegir una contraseña nueva.</p>

    <form asp-action="ForgotPassword" method="post" novalidate>
        <div asp-validation-summary="ModelOnly" class="alert alert-danger small py-2" role="alert"></div>

        <div class="mb-4">
            <label asp-for="Email" class="form-label"></label>
            <input asp-for="Email" class="form-control form-control-lg" placeholder="admin@infection.com" autocomplete="username" autofocus>
            <span asp-validation-for="Email" class="text-danger small"></span>
        </div>

        <button type="submit" class="btn btn-primary btn-lg w-100">Enviar enlace</button>
    </form>

    <p class="text-center mt-4 mb-0"><a asp-action="Login">Volver a iniciar sesión</a></p>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
