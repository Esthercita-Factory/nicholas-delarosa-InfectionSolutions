@model ProductResponse
@{
    ViewData["Title"] = Model.Name;
}

<section class="page-header">
    <div>
        <h1>@Model.Name</h1>
        <p class="d-flex gap-3 align-items-center">
            <span>Código @Model.Sku</span>
            <span class="badge @(Model.IsActive ? "text-bg-success" : "text-bg-secondary")">@(Model.IsActive ? "A la venta" : "Inactivo")</span>
        </p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary"><i class="bi bi-pencil me-1"></i> Editar</a>
        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger"><i class="bi bi-trash me-1"></i> Eliminar</a>
    </div>
</section>

<dl class="ledger">
    <div class="ledger-item is-key">
        <dt>Precio sin IVA</dt>
        <dd>
            <span class="ledger-value">@Model.Price.ToString("C2")</span>
            <span class="ledger-note">Con IVA: @((Model.Price * (1 + InfectionSolutions.Domain.Services.InventoryCalculator.TaxRate)).ToString("C2"))</span>
        </dd>
    </div>
    <div class="ledger-item">
        <dt>Stock disponible</dt>
        <dd>
            <span class="ledger-value">@Model.Stock</span>
            <span class="ledger-note">@Model.Unit.ToLowerInvariant()</span>
        </dd>
    </div>
    <div class="ledger-item">
        <dt>Categoría</dt>
        <dd>
            <span class="ledger-value">@Model.Category</span>
            <span class="ledger-note">venta por @Model.Unit.ToLowerInvariant()</span>
        </dd>
    </div>
</dl>

<section class="card">
    <div class="card-body p-4">
        <dl class="row mb-0 detail-list">
            <dt class="col-sm-3">Descripción</dt>
            <dd class="col-sm-9">@(Model.Description ?? "Sin descripción")</dd>
            <dt class="col-sm-3">Creado</dt>
            <dd class="col-sm-9">@Model.CreatedAt.ToLocalTime().ToString("g")</dd>
            <dt class="col-sm-3">Última actualización</dt>
            <dd class="col-sm-9">@(Model.UpdatedAt?.ToLocalTime().ToString("g") ?? "Sin cambios desde que se creó")</dd>
        </dl>
    </div>
</section>

<a asp-action="Index" class="btn btn-link px-0 mt-3"><i class="bi bi-arrow-left me-1"></i> Volver al listado</a>
