@model ProductFormViewModel

<div class="row g-3">
    <div class="col-12 col-sm-4">
        <label asp-for="Sku" class="form-label"></label>
        <input asp-for="Sku" class="form-control text-uppercase" placeholder="CEM-ARG-50" maxlength="30">
        <span asp-validation-for="Sku" class="text-danger small"></span>
    </div>
    <div class="col-12 col-sm-8">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" placeholder="Cemento gris Argos 50 kg" maxlength="120">
        <span asp-validation-for="Name" class="text-danger small"></span>
    </div>

    <div class="col-12 col-sm-6">
        <label asp-for="Category" class="form-label"></label>
        <input asp-for="Category" class="form-control" list="categorias" placeholder="Cementos" maxlength="80" autocomplete="off">
        <datalist id="categorias">
            @foreach (var categoria in Model.Categories)
            {
                <option value="@categoria"></option>
            }
        </datalist>
        <span asp-validation-for="Category" class="text-danger small"></span>
    </div>
    <div class="col-12 col-sm-6">
        <label asp-for="Unit" class="form-label"></label>
        <select asp-for="Unit" class="form-select">
            @foreach (var unidad in ProductFormViewModel.Units)
            {
                <option value="@unidad">@unidad</option>
            }
            @if (!ProductFormViewModel.Units.Contains(Model.Unit))
            {
                <option value="@Model.Unit" selected>@Model.Unit</option>
            }
        </select>
        <span asp-validation-for="Unit" class="text-danger small"></span>
    </div>

    <div class="col-12 col-sm-6">
        <label asp-for="Price" class="form-label"></label>
        <div class="input-group">
            <span class="input-group-text">$</span>
            <input asp-for="Price" class="form-control" type="number" step="0.01" min="0.01" placeholder="0.00">
        </div>
        <span asp-validation-for="Price" class="text-danger small"></span>
    </div>
    <div class="col-12 col-sm-6">
        <label asp-for="Stock" class="form-label"></label>
        <input asp-for="Stock" class="form-control" type="number" step="1" min="0" placeholder="0">
        <span asp-validation-for="Stock" class="text-danger small"></span>
    </div>

    <div class="col-12">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control" rows="3" maxlength="1000" placeholder="Uso, especificaciones o presentación del producto"></textarea>
        <span asp-validation-for="Description" class="text-danger small"></span>
    </div>

    <div class="col-12">
        <div class="form-check form-switch">
            <input asp-for="IsActive" class="form-check-input" role="switch">
            <label asp-for="IsActive" class="form-check-label"></label>
        </div>
    </div>
</div>
